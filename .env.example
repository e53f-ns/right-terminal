# ── MODE ──────────────────────────────────────────────
PAPER_TRADING=true

# ── KALSHI ────────────────────────────────────────────
KALSHI_API_KEY=your_kalshi_api_key     # from kalshi.com/account/api → only needed for live trading
KALSHI_PAPER=true
KALSHI_INITIAL_BALANCE=1000            # paper balance in USD

# ── EXCHANGE ──────────────────────────────────────────
BYBIT_API_KEY=your_key_here
BYBIT_SECRET=your_secret_here
BYBIT_TESTNET=false

# ── AI ────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_key_here
CLAUDE_MODEL=claude-opus-4-6

# ── DATA SOURCES ──────────────────────────────────────
CRYPTOPANIC_API_KEY=your_free_tier_key   # free at cryptopanic.com
# CoinGecko public API (fear/greed, dominance, liquidation zones) — no key needed
# Liquidation levels derived from CoinGecko OHLC data — no key needed

# ── TRADING PAIRS ─────────────────────────────────────
TRADING_PAIRS=BTC/USDT,ETH/USDT,SOL/USDT,BNB/USDT,XRP/USDT
SCAN_INTERVAL_MINUTES=15

# ── RISK MANAGEMENT ───────────────────────────────────
MIN_CONFIDENCE=75
MAX_TOTAL_EXPOSURE_PCT=15
DAILY_LOSS_LIMIT_PCT=8
LOSS_STREAK_PAUSE_TRADES=3
LOSS_STREAK_PAUSE_MINUTES=60

# ── POSITION SIZING ───────────────────────────────────
SIZE_TIER_LOW_PCT=3
SIZE_TIER_MID_PCT=5
SIZE_TIER_HIGH_PCT=7

# ── PAPER TRADING ─────────────────────────────────────
PAPER_INITIAL_BALANCE=10000

# ── POLYMARKET ────────────────────────────────────────
POLYMARKET_PAPER=true
POLYMARKET_PRIVATE_KEY=your_l2_private_key_here   # from polymarket.com/profile → Export L2 Key
POLYMARKET_INITIAL_BALANCE=1000                   # paper balance in USDC

# ── LOGGING ───────────────────────────────────────────
LOG_LEVEL=INFO
LOG_TO_FILE=true
LOG_DIR=logs
